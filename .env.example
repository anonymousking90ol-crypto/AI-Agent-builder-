# =========================
# GEMINI
# =========================
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# =========================
# GROQ
# =========================
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# =========================
# QDRANT
# =========================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# =========================
# POSTGRESQL
# =========================
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
# IMPORTANT: if your password contains special characters (@, :, /, %, etc.)
# they MUST be URL-encoded or the URL will be parsed incorrectly.
# e.g. a literal "@" in the password must be written as %40, e.g.
#   password  Postgres@123  ->  DATABASE_URL=postgresql://postgres:Postgres%40123@localhost:5432/chatbot_builder
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatbot_builder

# =========================
# EMAIL
# =========================
EMAIL_API_KEY=
EMAIL_FROM=noreply@aichatbotbuilder.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# =========================
# GOOGLE OAUTH (optional)
# =========================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =========================
# TWILIO / OPTIONAL
# User-owned WhatsApp integration (platform-level fallback, optional)
# =========================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# =========================
# APPLICATION
# =========================
SECRET_KEY=change-this-super-secret-key
JWT_SECRET=change-this-jwt-secret
FERNET_KEY=
FLASK_ENV=development
HOST=0.0.0.0
PORT=8000
BASE_URL=http://localhost:8000

# Default admin bootstrap (used by `python main.py createadmin` or auto-seed)
ADMIN_EMAIL=admin@aichatbotbuilder.local
ADMIN_PASSWORD=Admin@12345
